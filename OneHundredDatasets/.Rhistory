ggpubr::ggarrange(plotlist = sapply(res, "[[", 4), nrow = 2, ncol = 4, common.legend = TRUE)
# Testing...
dfKendall <- do.call(rbind, sapply(res, "[[", 2, USE.NAMES = T, simplify = F))
# Test first
dfTest <- dfKendall |>
rstatix::pairwise_wilcox_test(
kendall ~ item,
paired = TRUE,
p.adjust.method = "holm"
)
# Test first
dfTest <- dfKendall |>
rstatix::pairwise_wilcox_test(
kendall ~ normalization,
paired = TRUE,
p.adjust.method = "holm"
)
# Test first
dfTest <- dfKendall |>
rstatix::pairwise_wilcox_test(
kendall ~ normalization,
paired = TRUE,
p.adjust.method = "holm"
)
ggplot(dfKendall, aes(x = item, y = kendall)) +
geom_boxplot(outlier.shape = NA) +
geom_jitter(width = 0.12, alpha = 0.25) +
theme_bw() +
labs(
x = NULL,
y = "Kendall's tau"
)
ggplot(dfKendall, aes(x = normalization, y = kendall)) +
geom_boxplot(outlier.shape = NA) +
geom_jitter(width = 0.12, alpha = 0.25) +
theme_bw() +
labs(
x = NULL,
y = "Kendall's tau"
)
dfTest <- dfTest %>%
rstatix::add_xy_position(x = "item")
dfTest$y.position <- 1+seq(0.1, 1.1, 0.05)
ggplot(dfKendall, aes(x = item, y = kendall)) +
geom_boxplot(outlier.shape = NA) +
geom_jitter(width = 0.12, alpha = 0.25) +
stat_pvalue_manual(
dfTest,
label = "p.adj.signif",
hide.ns = TRUE
) +
theme_bw() +
labs(
x = NULL,
y = "Kendall's tau"
)
ggplot(dfKendall, aes(x = normalization, y = kendall)) +
geom_boxplot(outlier.shape = NA) +
geom_jitter(width = 0.12, alpha = 0.25) +
stat_pvalue_manual(
dfTest,
label = "p.adj.signif",
hide.ns = TRUE
) +
theme_bw() +
labs(
x = NULL,
y = "Kendall's tau"
)
dfTest
dfTest <- dfTest %>%
rstatix::add_xy_position(x = "normalization")
dfTest$y.position <- 1+seq(0.1, 1.1, 0.05)
ggplot(dfKendall, aes(x = normalization, y = kendall)) +
geom_boxplot(outlier.shape = NA) +
geom_jitter(width = 0.12, alpha = 0.25) +
