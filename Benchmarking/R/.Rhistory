x = "Original rank",
y = paste0("LOO ", item, " rank"),
fill = "Frequency"
)
# 4) Outputs
return(
list(
kendalDF = kendallItemX,
kendalPloDF = dfKendall,
pKendall = pKendall,
pHeatmap = pHeatmap
)
)
}
