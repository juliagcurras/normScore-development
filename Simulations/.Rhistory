# Data
out <- readRDS(file = "../Datos/20251216_preparedData_2_01.rds")
# Results
transcriptomica <- readRDS(file = "../Datos/20260115_IndividualRNAMDA.rds")
proteomica <- readRDS(file = "../Datos/20260115_IndividualProteomicsMDA.rds")
# Variables
coloresGrupos <-  c(
"CN"    = "#377EB8",
"CT"  = "#FF7F00",
"LIP" = "#999999",
"M0" = "#4DAF4A",
"M1" = "#F781BF"
)
# Data
dataRNA <- as.data.frame(t(out$RNA_MDA))
grupoRNA <- sapply(strsplit(rownames(dataRNA), split = "_"), "[[", 1)
# Models
pcaModel <- transcriptomica$PCA1_Model
finalModel <- transcriptomica$splsDA1_Model
perfModel <- transcriptomica$splsDA2_Performance
annotation_row <- data.frame(Group = factor(grupoRNA))
rownames(annotation_row) <- rownames(dataRNA)
mat <- dataRNA
pheatmap::pheatmap(
mat,
scale = "column",           # igual que antes
color = grDevices::colorRampPalette(c("green", "black", "red"))(100),          # paleta azul
cluster_rows = TRUE,        # dendrograma por filas
cluster_cols = TRUE,       # SIN dendrograma superior
show_colnames = FALSE,      # labCol = ""
# clustering_callback = callback,
annotation_row = annotation_row,
annotation_colors = list(Group = c(
"CN"    = "#377EB8",
"CT"  = "#FF7F00",
"LIP" = "#999999",
"M0" = "#4DAF4A",
"M1" = "#F781BF"
)),
main = "MDA - clustering by gene expression (scaled)",
fontsize = 12
)
# , , , "#", ""
# heatmap(t(datos_RNA_MDA), scale = "col")
printFigTitle("Mapa de calor y clustering para datos normalizados, escalados y filtrados de expresión génica, cuantificada en muestras MDA. Medida de distancia: distancia euclídea; método de aglomeración: ligamiento completo.")
dfAux <- data.frame(
var = names(transcriptomica$PCA0_Tune$prop_expl_var$X),
freqVar = unname(transcriptomica$PCA0_Tune$prop_expl_var$X)
)
dfAux$var <- factor(dfAux$var, levels = unique(dfAux$var))
Biostatech::plotBarUnivar(
var = dfAux$var,
freqVar = dfAux$freqVar,
freqRel = T,
tituloX = "Principal Components",
tituloY = "Explained Variance",
color = Biostatech::colorPalette(n=2)[1],
limY = c(0, 0.3)
)$grafico
printFigTitle("Proporción de varianza explicada por cada uno de los componentes del modelo inicial.")
# plot(transcriptomica$PCA0_Tune)
tab <- data.frame(
componentes = names(pcaModel$prop_expl_var$X), # Varianza de cada compoñente
VarByComp = unname(pcaModel$prop_expl_var$X), # Varianza de cada compoñente
VarCum = unname(pcaModel$cum.var) # Varianza acumulada
)
tab$PorcentajeVar <- round(tab$VarByComp*100, 2)
tab$PorcentajeCum <- round(tab$VarCum*100, 2)
p1 <- ggplot(tab, aes(x = componentes, y = VarByComp, group = "1")) +
geom_line(linewidth = 1, colour = Biostatech::colorPalette(n=1)) +
geom_point(size = 3, colour = Biostatech::colorPalette(n=1)) +
geom_label(
aes(label = paste0(PorcentajeVar, "%")),
nudge_y = 0.02,        # 👈 desplazamiento en UNIDADES DE PROPORCIÓN
nudge_x = 0.1,
fill = "white",
label.size = 0.2,
size = 4
) +
scale_y_continuous(labels = scales::percent, limits = c(0, 0.3)) +
theme_minimal(base_size = 14) +
ylab("Explained variance") + xlab("PCA components")+
theme(
axis.line = ggplot2::element_line(linewidth = 0.5, colour = "black"),
axis.ticks = ggplot2::element_line(linewidth = 0.5, colour = "black")
)
p2 <- ggplot(tab, aes(x = componentes, y = VarCum, group = "1")) +
geom_line(linewidth = 1, colour = Biostatech::colorPalette(n=2)[2]) +
geom_point(size = 3, colour = Biostatech::colorPalette(n=2)[2]) +
geom_label(
aes(label = paste0(PorcentajeCum, "%")),
nudge_y = 0.02,        # 👈 desplazamiento en UNIDADES DE PROPORCIÓN
nudge_x = 0.1,
fill = "white",
label.size = 0.2,
size = 4
) +
scale_y_continuous(labels = scales::percent, limits = c(0, 0.6)) +
theme_minimal(base_size = 14) +
ylab("Cumulative variance") + xlab("PCA components")+
theme(
axis.line = ggplot2::element_line(linewidth = 0.5, colour = "black"),
axis.ticks = ggplot2::element_line(linewidth = 0.5, colour = "black")
)
ggpubr::ggarrange(p1, p2, ncol = 2, nrow = 1)
cat("\n\n")
printFigTitle("Varianza explicada por cada componente principal de forma individual (izquierda) y acumulada (derecha).")
