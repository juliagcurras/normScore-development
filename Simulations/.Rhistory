# Datos de ejemplo: relaciones entre categorías A-D
mat <- matrix(
c(10, 5, 2, 8,
3, 7, 1, 4,
6, 2, 9, 5,
4, 3, 6, 7),
nrow = 4,
byrow = TRUE,
dimnames = list(letters[1:4], letters[1:4])
)
# Crear un chord diagram sin labels
chordDiagram(
mat,
annotationTrack = "grid",   # Solo marco circular
preAllocateTracks = 1,
grid.col = c(a = "steelblue", b = "tomato", c = "gold", d = "forestgreen")
)
# Eliminar las etiquetas
circos.clear()
# Crear un chord diagram sin labels
chordDiagram(
mat,
annotationTrack = "grid",   # Solo marco circular
preAllocateTracks = 1
# grid.col = c(a = "steelblue", b = "tomato", c = "gold", d = "forestgreen")
)
df <- data.frame(
Protein = c("P1", "P2", "P3", "P4", "P5"),
Function = c("F1", "F1", "F2", "F3", "F3")
)
# Definir todos los sectores (primero proteínas, luego funciones)
sectors <- c(unique(df$Protein), unique(df$Function))
# Colores para proteínas y funciones
col_proteins <- rep("skyblue", length(unique(df$Protein)))
col_functions <- rep("salmon", length(unique(df$Function)))
grid_colors <- setNames(c(col_proteins, col_functions), sectors)
# Definir gaps: 0.2 entre proteínas y funciones, 0.02 entre los demás
gaps <- c(rep(0.02, length(unique(df$Protein)) - 1), 0.2,
rep(0.02, length(unique(df$Function)) - 1), 0.2)
# Construir el chord diagram
chordDiagram(
x = df,
grid.col = grid_colors,
annotationTrack = "grid",
preAllocateTracks = 1,
big.gap = 20,   # opcional, hace más visible el hueco
gap.after = gaps
)
