groupVar = "ONTOLOGY",
shortenDescription = T,
maxLengthDescription = 50,
minCount = 4,
maxCount = 7,
sizeTituloX = 16,
sizeTextY = 12,
sizeTextLeyenda = 12,
sizeTextX = 14)$grafico + theme(strip.text = element_text(size = 16))
printFigTitle("Para los primeros 30 términos enriquecidos se representa mediante rombos el ratio de proteínas asociados al término entre las proteínas totales. El tamaño de los rombos viene determinado por la cantidad de proteínas. El color de los rombos corresponde con el p-valor ajustado del término.")
dfAux <- dfRes
listLong <- apply(dfAux, 1, function(fila){ # Obtemos GO ID - Protein ID
resL <- strsplit(x = fila["geneID"], split = "/", fixed = T)[[1]]
return(data.frame(
GO = rep(fila["ID"], length(resL)),
Protein = resL))
}, simplify = T)
dfPairs <- do.call(rbind, listLong) # xuntamos nun data.frame
rownames(dfPairs) <- 1:nrow(dfPairs)
dfPairs <- merge(
dfPairs,
dfAux, # dfAux[,c(2,4:11, 13:14)],
by.x="GO",
by.y="ID") # Engadimos IDs por si acaso
dfPairs$LogFC <- NA
# dfPairs1 <- dfPairs %>%
#   dplyr::filter(Protein %in% protName[1:5]) %>%
#   group_by(Protein) %>%
#   dplyr::slice(1:7) %>%
#   ungroup()
dfPairs <- dfPairs %>% arrange(pvalue)
Biomics::plotNet(
dfPairs = dfPairs,
n_terms = 20,
layout =  "lgl",
useGOid = F,
map_term_p = T,
map_prot_logFC = T,
size_terms_by_count = T,
term_label_size = 4,
protein_label_size = 5,
# title_size = 20,
# legend_title_size = 16,
# legend_text_size = 14,
main_title = "GO terms - protein net",
legend_position = "right")$grafico
printFigTitle("Interrelación de términos funcionales y proteínas asociadas a los mismos. Las funciones se representan mediante círculos y las proteínas, mediante cuadrados. El color de los términos corresponde al p-valor ajustado y su tamaño, a la cantidad de proteínas asociada a ese término.")
View(tabM0)
Biostatech:::addinWiki()
23/4
Biomics:::addinWiki()
