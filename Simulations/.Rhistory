colores <- Biostatech::colorPalette(n= 4)
getStability <- function(comp = 1, ...){
# Extract essential info
nombreComp <- paste0("comp", comp)
stable.comp1 <- perfModel$features$stable[[nombreComp]]
genesSelected <-  selectVar(finalModel, comp = comp)$name
# Dataframe
df <- data.frame(Stability = as.numeric(unname(stable.comp1)),
Genes = names(stable.comp1))
df <- df %>% dplyr::filter(Genes %in% genesSelected)
df <- df[order(df$Stability, decreasing = T), ]
df$Genes <- factor(df$Genes, levels = df$Genes)
df$Component <- factor(paste0("Component ", comp))
df <- df %>% dplyr::select(Component, Genes, Stability)
# plot
p <- Biostatech::plotBarUnivar(var = df$Genes,
freqVar = df$Stability,
freqRel = T,
sizeLetra = 6,
verticalBars = T,
tituloY = "Stability",
tituloX = paste0("Selected genes for component ", comp),
limY = c(0,1),
anguloX = 65,
color = colores[comp], ...)$grafico
return(list(df, p))
}
plotLoadings <- function(
modelo,
comp = 1,
umbral = 0,
color  = NULL,
sizeLetra = 14,
legendPosition = "right",
titulo = paste0("Contribution on component ", comp),
subtitulo = paste0("Filter by correlation (r>", umbral, ")")
){
# Manual plotting for plotLoading
Y <- modelo$Y # Grupos
X <- modelo$X # Variables
# Correlations
cor_X_PCs <- cor(X, modelo$variates$X)
if (!is.null(modelo$loadings$X)) {
keep <- abs(modelo$loadings$X[, comp]) > 0
cor_X_PCs <- cor_X_PCs[keep, ]
}
# Filter
idxProts <- rownames(cor_X_PCs[abs(cor_X_PCs[, comp]) > umbral, , drop = FALSE])
# Max mean contribution
mean_by_group <- sapply(unique(Y), function(g) {
colMeans(X[Y == g, idxProts, drop = FALSE], na.rm = TRUE)
}, USE.NAMES = T)
colnames(mean_by_group) <- unique(Y)
mean_by_group <- as.data.frame(mean_by_group)
group_contrib <- apply(mean_by_group, 1, function(v) {
names(v)[which.max(v)]
})
# All information together
df <- data.frame(var = idxProts,
loading = modelo$loadings$X[idxProts, comp, drop = T],
cor = cor_X_PCs[idxProts, comp, drop = T],
group = factor(unname(group_contrib), levels = unique(Y)))
df <- df %>%
mutate(abs_loading = abs(loading)) %>%
arrange(desc(abs_loading))
df$var <- factor(df$var, levels = df$var)
# plotting parámeters
if (is.null(color)) {
color <- Biostatech::colorPalette(n = length(unique(Y)))
names(color) = unique(Y)
}
# Plotting!
p <- ggplot2::ggplot(df, aes(x = var, y = loading, fill = group)) +
ggplot2::geom_col(width = 0.7) +
ggplot2::coord_flip() +
ggplot2::labs(
title = titulo,
subtitle = subtitulo,
x = NULL,
y = paste0("Loadings for component ", comp),
fill = "Group (max mean)"
) +
ggplot2::geom_hline(yintercept = 0, colour = "grey", linewidth = 0.1)+
ggplot2::theme_classic(base_size = sizeLetra) +
ggplot2::theme(
text = element_text(family = "Calibri", size = 14),
# axis.line = ggplot2::element_line(linewidth = 0.5, colour = "black"),
# axis.ticks = ggplot2::element_line(linewidth = 0.5, colour = "black"),
plot.subtitle = ggplot2::element_text(colour = "grey40", face = "italic"),
axis.line.y = element_blank(),
axis.line.x = element_line(linewidth = 0.7),
axis.ticks = element_blank(),
legend.position = legendPosition,
) +
scale_fill_manual(values = color)
return(list(grafico = p, tabla = df))
}
plotBarORA <- function(
df,
varID = "Description", # ORA
varY = "FoldEnrichment", # adjusted p.val...
varGroup = "ONTOLOGY",
topN = NA,
shortenDescription = F, # TRUE and labels will be truncked
maxLengthDescription = 35,
legendPosition = "left",
labelGroupPosition = "top",
textGroupDir = "h", # "v"
addBox = T,
paletaColor = c("#005B9A", "#2FB2AD", "#C3E5BC"),
# Etiquetas
titulo = "Enriched GO terms",
tituloX = "",
tituloY = NULL,
tituloLeyenda = "Group",
anguloX = 90,
# Size text
sizeTitulo = 18,
sizeAxisTitle = 16,
sizeTextX = 14,
sizeTitleLegend = 14,
sizeTextLegend = 12,
sizeTextoCajas = 12
){
# Select input vars
dfPlot <- df[, c(varID,varY, varGroup)]
colnames(dfPlot) <- c("ID", "varY", "Group")
# Arrange information
# Contar elementos por grupo
n_por_grupo <- dfPlot %>% count(Group)
condicion <- any(n_por_grupo$n > 10) && sum(n_por_grupo$n) > 30
topN <- if (condicion) 10 else topN
if (!is.na(topN)){
dfPlot <- dfPlot %>%
dplyr::group_by(Group) %>%
dplyr::arrange(desc(varY)) %>%
# dplyr::top_n(10) %>%
dplyr::slice(1:topN) %>%
# dplyr::mutate(ID = forcats::fct_reorder(.f = factor(ID),
#                                  .x = varY,
#                                  .desc = TRUE)) %>%
dplyr::ungroup()
}
# Shorten labels if required
if (shortenDescription & varID == "Description"){
maxLengthDescription <- ifelse(is.na(maxLengthDescription), 35,
ifelse(maxLengthDescription < 5, 5, maxLengthDescription))
varShortenDesc <- stringr::str_trunc(string = dfPlot$ID,
width = maxLengthDescription)
a <- 0
while (!is.na(table(table(varShortenDesc)>1)["TRUE"])) { # Si ao acortar se solapan nomes de descripcions
a <- a+1
varShortenDesc <- stringr::str_trunc(string = dfPlot$ID,
width = maxLengthDescription+a)
}
dfPlot$ID <- varShortenDesc
}
dfPlot <- dfPlot %>%
group_by(Group) %>%
arrange(desc(varY)) %>%
mutate(ID = forcats::fct_reorder(.f = factor(ID),
.x = varY,
.desc = TRUE)) %>%
ungroup()
grupos <- unique(dfPlot$Group)
tituloY <- ifelse(is.null(tituloY), varY, tituloY)
colores <- colorRampPalette(paletaColor)(length(grupos))
# Plot info
p <- ggplot2::ggplot(
dfPlot,
aes(
x=ID,
y = varY,
fill = Group)
) +
ggplot2::geom_col(
stat="identity",
position = position_dodge(width = 0.5)
) +
ggplot2::scale_fill_manual(
values = colores
) +
ggplot2::facet_wrap(
~Group,
scales = "free_x",
# space = "free_y",
nrow = 1,
dir = textGroupDir,
strip.position = labelGroupPosition) +
ggplot2::xlab(label = tituloX) +
ggplot2::ylab(label = tituloY) +
ggplot2::ggtitle(label = titulo)+
ggplot2::guides(fill = ggplot2::guide_legend(title = tituloLeyenda)) +
ggplot2::theme_minimal() +
ggplot2::theme(
legend.position = legendPosition,
title = element_text(size = sizeTitulo),
axis.title = element_text(size = sizeAxisTitle),
axis.text.x = element_text(angle = anguloX, hjust = 1, size = sizeTextX),
legend.text = element_text(size = sizeTextLegend),
strip.text = element_text(size = sizeTextoCajas),
legend.title = element_text(size = sizeTitleLegend),
axis.line = ggplot2::element_line(linewidth = 0.5, colour = "black"),
axis.ticks = ggplot2::element_line(linewidth = 0.5, colour = "black"))
if (addBox){
p <- p +
ggplot2::theme(
strip.background = element_rect(fill = "#F2F2F2", color = "darkgrey"),
strip.text = element_text(face = "bold", color = "black"))
}
return(p)
}
