plotVariable1 <- function(
modelo,
comp = 1:2,
umbral = 0,
type = NULL,
showOnlyLabels = FALSE,
color = NULL,
titulo = NULL,
subtitulo = NULL,
tituloX = NULL,
tituloY = NULL,
legendPosition = "right",
sizeLetra = 14,
sizeDots = 2,
shapeDots = 16
) {
# Initial Check #
if (length(comp) != 2){
stop("Just two components must be provided!!!")
}
# Extracting data #
# Auxiliar function
getDataFromModel <- function(modelo, type, comp){
matScores <- modelo$variates[[type]][, comp]   # components
cor_var <- cor(modelo$X[[type]], matScores) # compute correlation variables × componentes
dfLoading <- modelo$loadings$X
# Selecting variables: only in sparse
if (!is.null(dfLoading)) {
# equivalent to: unique(c(selectVar(finalModel, comp = 2)$name, selectVar(finalModel, comp = 1)$name))
keep <- apply(abs(dfLoading[, comp]), 1, sum) > 0 # selecting variables in any components
cor_var <- cor_var[keep, ]
}
# All together
df <- data.frame(
var   = rownames(cor_var),
comp1 = cor_var[, 1],
comp2 = cor_var[, 2],
group = type
)
return(df)
}
# Main conditional body
if (any(class(modelo)%in% c("block.splsda", "block.spls"))){ # more than one dimension
if (is.null(type)){
stop("Debes indicar la matriz de datos con la que trabajar")
}
resDF <- sapply(type, getDataFromModel, modelo = modelo, comp = comp, simplify = F, USE.NAMES = T)
df <- do.call(rbind, resDF)
} else {  # only one dimension
matScores <- modelo$variates$X[, comp]
cor_var <- cor(modelo$X, matScores) # compute correlation variables × componentes
dfLoading <- modelo$loadings$X
# Selecting variables: only in sparse
if (!is.null(dfLoading)) {
# equivalent to: unique(c(selectVar(finalModel, comp = 2)$name, selectVar(finalModel, comp = 1)$name))
keep <- apply(abs(dfLoading[, comp]), 1, sum) > 0 # selecting variables in any components
cor_var <- cor_var[keep, ]
}
# All together
df <- data.frame(
var   = rownames(cor_var),
comp1 = cor_var[, 1],
comp2 = cor_var[, 2],
group = "All"
)
}
# Drawing circles: r = 0.5 / r = 1
theta <- seq(0, 2*pi, length.out = 400)
circle <- function(r) data.frame(x = r*cos(theta), y = r*sin(theta), r = factor(r))
circles <- rbind(circle(0.5), circle(1))
# Filtering by cor with each comp
grupos <- unique(df$group)
df <- df[abs(df$comp1) > umbral | abs(df$comp2) > umbral, , drop = FALSE]
df$group <- factor(df$group, levels = grupos)
# Color
if (is.null(color)){
color <- Biostatech::colorPalette(n=length(grupos))
}
# Axis titles
if (is.null(tituloX)){
tituloX <- paste0("Correlation with comp ", comp[1])
}
if (is.null(tituloY)){
tituloY <- paste0("Correlation with comp ", comp[2])
}
# Plotting!
p <- ggplot2::ggplot(
data = df,
ggplot2::aes(
x = comp1,
y = comp2,
color = group)
) +
ggplot2::geom_path( # círculos r=0.5 y r=1
data = circles,
ggplot2::aes(x = x, y = y, group = r),
inherit.aes = FALSE,
linewidth = 0.5,
color = "grey60"
) +
# ejes en 0
ggplot2::geom_hline(yintercept = 0, linetype = "dashed", color = "grey70") +
ggplot2::geom_vline(xintercept = 0, linetype = "dashed", color = "grey70") +
ggplot2::coord_equal(xlim = c(-1, 1), ylim = c(-1, 1)) +
ggplot2::labs(
title = titulo,
subtitle = subtitulo,
x = tituloX,
y = tituloY,
color = "Group"
) +
ggplot2::theme_minimal(base_size = sizeLetra) +
ggplot2::scale_color_manual(values = color) +
ggplot2::theme(
# axis.line = ggplot2::element_line(linewidth = 0.5, colour = "black"),
# axis.ticks = ggplot2::element_line(linewidth = 0.5, colour = "black"),
plot.subtitle = ggplot2::element_text(colour = "grey40", face = "italic")
)
if (!showOnlyLabels) {
p <- p +
ggplot2::geom_point(size = sizeDots, shape = shapeDots) +
ggrepel::geom_text_repel(aes(label = var),
size = sizeLetra/4,
max.overlaps = Inf)
} else if (showOnlyLabels) {
p <- p +
ggplot2::geom_text(aes(label = var), size = sizeLetra/4)
}
if (length(grupos) == 1){
p <- p + ggplot2::theme(legend.position = "none")
} else {
p <- p + ggplot2::theme(legend.position = legendPosition)
}
return(list(grafico = p))
}
# p1_PRO
