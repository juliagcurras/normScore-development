# DF 6M
data6M <- data %>% filter(!is.na(`Fecha 2ª administración`))
data6M$`Nº hospitalizaciones (6 meses seguimiento)` <- factor(data6M$`Nº hospitalizaciones (6 meses seguimiento)`)
# DF 12 M
data12M <- data %>% filter(!is.na(`Fecha 3ª administración`))
data12M$TotalHosp <- data12M$`Nº hospitalizaciones (6 meses seguimiento)` + data12M$`Nº hospitalizaciones (12 meses seguimiento)`
data12M$TotalHosp <- factor(data12M$TotalHosp)
Hmisc::label(data12M$TotalHosp) <- "Total hospitalizaciones (12 meses)"
Hmisc::label(data12M$TiempoEvolucionAnos) <- "Tiempo evolución (años)"
data12M <- data12M %>%
rename(`Tiempo evolución (años)` = TiempoEvolucionAnos)
resultCor <- getCorrelation(data12M,
varsX = c("CGI 12 meses", "Sheehan (ítem 1-4) 12 meses"),
varsY = c("Edad de diagnóstico", "Edad Inicio Tratamiento",
"Tiempo evolución (años)"), method = "spearman", graficos = T)
printTabTitle("Resultados del análisis de correlación para las variables cuantitativas sociodemográficas o clínicas respecto a las variables cuantitativas respuesta del estudio a los 12 meses de seguimiento.")
resultCor$tablaFormato
basalRespCat <- c("TotalHosp", "Monoterapia antipsicótica 12 meses", "ConsumoToxicos12M_2")
for (i in basalRespCat){
cat("\n\n##### ", ifelse(Hmisc::label(data[i]) == "", colnames(data[i]), Hmisc::label(data[i])), " {- .tabset} \n\n")
# cat("\n\n##### ", i, " {-}\n\n")
df <- data12M %>% select(i, `Edad de diagnóstico`, `Edad Inicio Tratamiento`,
`Tiempo evolución (años)`)
colnames(df)[1] <- "Grupo"
printTabTitle(paste0("Análisis descriptivo y resultado del test de contraste de hipótesis para estudiar la relación entre la variable ", ifelse(Hmisc::label(data[i]) == "", colnames(data[i]), Hmisc::label(data[i]))," y las variables cuantitativas sociodemográficas y clínicas a los 12 meses de seguimiento."))
result <- tableDescr(Grupo~., df, graficos = "sign")
print(htmltools::tagList(result$tablaFormato))
varsLista <- names(result$graficos)
for (nome in varsLista){
cat("\n\n###### ", nome, "{-}\n\n")
cat("\n\n<div align='center' style = 'width:65%; height:auto; margin: auto;'>\n\n")
print(htmltools::tagList(result$graficos[[nome]]))
cat("\n\n</div>\n\n")
printFigTitle(paste0("Representación gráfica de la variable ", nome, "."))
cat("\n\n")
}
}
