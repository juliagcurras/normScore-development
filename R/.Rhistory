mode='lines+markers',
line=list(color=cores[k]),
marker = list(color = cores[k]),
name = L[k],
text = paste0(
"<b>", tituloY,"</b>",
"<br>___________________",
"<br>", tituloX,": ", dfk$normNames,
"<br>", L[k],": ", round(dfk$y, 3)
),
hoverinfo = 'text')
}
fig <- fig %>%
plotly::layout(
legend = list(title=list(text=paste0('<b> ', tituloLeyenda,' </b>'))),
xaxis = list(ticktext= df$normNames,
tickvals= df$varX,
showticklabels = TRUE,
showline = T, ticks = "outside",
linewidth = 1, linecolor = "black",
title = tituloX),
yaxis = list(
title = tituloY, hoverformat = ".2f",
ticks = "outside", showline = T,
linewidth = 1, linecolor = "black", zerolinecolor = "darkgrey")
) %>%
plotly::config(
modeBarButtonsToRemove = c(
"autoScale2d", "lasso2d", "pan2d",
"select2d"
),
displaylogo = FALSE
)
if (!is.null(yLim)){
fig <- fig %>% layout(yaxis = list(range = yLim))
}
return(list(grafico = fig))
}
getkappaMatrix <- function(df){
# parámetro "df": data frame con las variables categóricas de interés
KappaMatrix <- apply(df, 2, function(i) apply(df, 2, function(j) { # "iterar" por columnas dos veces
vcd::Kappa(table(i, j))[["Unweighted"]]["value"]
}))
return(KappaMatrix)
}
plotBoxMultivar2 <- function(base, varResumen, titulo = "", tituloX = "",
tituloY = "", color = NULL, show.legend = FALSE,
interact = TRUE) {
# Si no se proporciona una paleta de color, usar la paleta original
nGrupos <- length(varResumen)
paleta <- Biostatech::colorPalette()
if (is.null(color)) {
cores <- Biostatech::colorPalette(n = nGrupos, removeWhite = T)
} else if (length(color) == 1) {
cores <- rep(color, nGrupos)
} else if (length(color) < nGrupos) {
warning("El número de colores definidos es menor que el número de grupos")
cores <- color
} else {
cores <- color
}
# Seleccionar las variables a graficar
df <- as.data.frame(base[, varResumen])
if(ncol(df) == 1 & length(varResumen) == 1){
# df <- as.data.frame(df)
colnames(df) <- varResumen
}
if (!(all(colnames(df) == varResumen))){
stop("Some variables were not found on the input database.")
}
# Convertir el data.frame en un formato 'long' usando tidyr::pivot_longer
df_long <- df %>%
tidyr::pivot_longer(cols = tidyr::everything(), names_to = "Variable", values_to = "Valor")
# Crear un gráfico de cajas Plotly para cada variable
p <- plotly::plot_ly(data = df_long, x = ~Variable, y = ~Valor, type = "box",
color = ~Variable, colors = cores, line = list(width = 1)) %>%
plotly::layout(title = titulo,
xaxis = list(title = tituloX, showgrid = F, ticks = "outside",
showline = T, linewidth = 1, linecolor = "black"),
yaxis = list(title = tituloY, hoverformat = ".2f",
showline = T, zerolinecolor = "darkgrey",
linewidth = 1, linecolor = "black", ticks = "outside"),
showlegend = show.legend) %>%
plotly::config(modeBarButtonsToRemove = c("hoverClosestCartesian", "autoScale2d",
"lasso2d", "select2d", "pan2d",
"hoverCompareCartesian"),
displaylogo = FALSE)
if (!interact) {
p <- p %>% plotly::config(displayModeBar = F) %>%
plotly::layout(xaxis = list(fixedrange = TRUE)) %>%
plotly::layout(yaxis = list(fixedrange = TRUE)) %>%
plotly::style(hoverinfo = "none")
}
return(list(grafico = p))
}
