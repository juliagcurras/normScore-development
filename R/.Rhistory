scoreDF
rankingDF$Total <- rowSums(rankingDF)
scoreDF_norm <- as.data.frame(scoreDF_norm)
scoreDF_norm$Total <- rowSums(scoreDF_norm)
scoreDF_norm
rankingDF <- as.data.frame(apply(scoreDF_norm, 2, dplyr::dense_rank, simplify = T))
rankingDF
